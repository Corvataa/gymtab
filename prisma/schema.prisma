// Esquema de la base de datos.
// Cada "model" es una tabla. Si cambiás algo acá, corré: npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL (en producción, Supabase).
  // DATABASE_URL: conexión que usa la app. DIRECT_URL: conexión para crear/actualizar tablas.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Configuración del gimnasio (una sola fila, id = 1)
model Settings {
  id           Int     @id @default(1)
  gymName      String  @default("Mi gimnasio")
  dueDay       Int     @default(10) // día del mes en que vence la cuota
  blockOverdue Boolean @default(true) // si la cuota está vencida, no puede sumar consumos ni reservar
  cancelHours  Int     @default(2) // hasta cuántas horas antes de la clase se puede cancelar
  bookingDays  Int     @default(7) // con cuántos días de anticipación se puede reservar
  logo         String? // logo del gimnasio como imagen (data URL), se sube desde Configuración
  logoVersion  Int     @default(0) // cambia cada vez que se sube un logo nuevo
}

// Un plan de cuota (ej: "3 veces por semana", "Libre")
model Plan {
  id             String   @id @default(cuid())
  name           String
  price          Int // cuota mensual en pesos
  classesPerWeek Int? // vacío = libre
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  members        Member[]
}

// Un socio del gimnasio
model Member {
  id           String           @id @default(cuid())
  name         String
  dni          String           @unique
  pinHash      String // el PIN se guarda encriptado, nunca en texto plano
  phone        String?
  email        String?
  plan         Plan?            @relation(fields: [planId], references: [id])
  planId       String?
  monthlyLimit Int              @default(20000) // tope de consumo mensual en pesos
  active       Boolean          @default(true)
  approved     Boolean          @default(true) // false = se anotó solo y espera aprobación del gimnasio
  createdAt    DateTime         @default(now())
  consumptions Consumption[]
  payments     Payment[]
  checkouts    Checkout[]
  bookings     Booking[]
  results      WorkoutResult[]
  records      PersonalRecord[]
}

// Un cobro: la cuota de un mes + los consumos que estaban pendientes
model Payment {
  id             String        @id @default(cuid())
  member         Member        @relation(fields: [memberId], references: [id])
  memberId       String
  period         String // mes de cuota que se paga, "2026-11"
  planName       String? // copiamos el plan por si después cambia
  feeAmount      Int // monto de la cuota
  consumosAmount Int // monto de consumos incluidos
  total          Int
  method         String // efectivo, transferencia, tarjeta, mercadopago
  coversFee      Boolean       @default(true) // true = incluye la cuota del mes; false = solo consumos
  notes          String?
  voided         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  consumptions   Consumption[]
  checkout       Checkout?

  @@index([memberId, period])
  @@index([createdAt])
}

// Un intento de pago online con Mercado Pago.
// Se crea cuando el socio toca "Pagar" y se completa cuando Mercado Pago confirma el pago.
model Checkout {
  id             String   @id @default(cuid())
  member         Member   @relation(fields: [memberId], references: [id])
  memberId       String
  period         String
  coversFee      Boolean
  feeAmount      Int
  consumoIds     String[] // consumos incluidos al momento de pagar
  consumosAmount Int
  total          Int
  status         String   @default("pending") // pending, approved, rejected
  mpPreferenceId String?
  mpPaymentId    String?  @unique
  payment        Payment? @relation(fields: [paymentId], references: [id])
  paymentId      String?  @unique
  createdAt      DateTime @default(now())

  @@index([memberId, status])
}

// Un producto que se vende (agua, barrita, bebida isotónica...)
model Product {
  id           String        @id @default(cuid())
  name         String
  price        Int // en pesos
  emoji        String        @default("🥤")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  consumptions Consumption[]
}

// Cada vez que un socio saca algo
model Consumption {
  id          String   @id @default(cuid())
  member      Member   @relation(fields: [memberId], references: [id])
  memberId    String
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  productName String // copiamos nombre y precio por si después cambian
  unitPrice   Int
  quantity    Int      @default(1)
  period      String // mes al que se carga, formato "2026-11"
  voided      Boolean  @default(false) // anulado por error
  payment     Payment? @relation(fields: [paymentId], references: [id])
  paymentId   String? // cobro en el que se incluyó (vacío = pendiente de cobro)
  createdAt   DateTime @default(now())

  @@index([memberId, period])
  @@index([memberId, paymentId])
}

// Intentos fallidos de login, para bloquear a quien prueba PINs o contraseñas al azar
model LoginThrottle {
  key         String    @id // ej: "socio:30111222" o "admin:<ip>"
  failures    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Un horario fijo semanal (ej: "Lunes 07:00 CrossTraining, 15 lugares")
model ClassSchedule {
  id          String         @id @default(cuid())
  name        String
  weekday     Int // 1 = lunes ... 7 = domingo
  startTime   String // "07:00"
  durationMin Int            @default(60)
  capacity    Int            @default(15)
  coach       String?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  sessions    ClassSession[]
}

// Una clase concreta en una fecha (se generan solas a partir de los horarios)
model ClassSession {
  id          String         @id @default(cuid())
  schedule    ClassSchedule? @relation(fields: [scheduleId], references: [id])
  scheduleId  String?
  name        String
  startsAt    DateTime
  durationMin Int
  capacity    Int
  coach       String?
  cancelled   Boolean        @default(false) // suspendida por el gimnasio
  bookings    Booking[]

  @@unique([scheduleId, startsAt])
  @@index([startsAt])
}

// La reserva de un socio para una clase
model Booking {
  id          String       @id @default(cuid())
  session     ClassSession @relation(fields: [sessionId], references: [id])
  sessionId   String
  member      Member       @relation(fields: [memberId], references: [id])
  memberId    String
  status      String // confirmed (tiene lugar), waitlist (lista de espera), cancelled
  createdAt   DateTime     @default(now())
  cancelledAt DateTime?

  @@unique([sessionId, memberId])
  @@index([memberId, status])
}

// Entrenamiento del día que publica el coach
model Workout {
  id          String          @id @default(cuid())
  date        String // "2026-11-10"
  title       String // ej: "WOD", "Fuerza", "Funcional"
  description String // el entrenamiento, en texto libre
  scoreType   String // time, reps, rounds_reps, weight, none
  published   Boolean         @default(true)
  createdAt   DateTime        @default(now())
  results     WorkoutResult[]

  @@index([date])
}

// Resultado de un socio en un entrenamiento
model WorkoutResult {
  id        String   @id @default(cuid())
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId String
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  value     Int // tiempo en segundos, repeticiones, rondas*1000+reps o peso en décimas de kg
  rx        Boolean  @default(true) // hecho como estaba escrito (sin adaptar)
  notes     String?
  createdAt DateTime @default(now())

  @@unique([workoutId, memberId])
}

// Marca personal de un socio en un ejercicio (ej: sentadilla 100 kg)
model PersonalRecord {
  id        String   @id @default(cuid())
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  movement  String
  weight    Int // décimas de kg (1025 = 102,5 kg)
  reps      Int      @default(1)
  date      String // "2026-11-10"
  notes     String?
  createdAt DateTime @default(now())

  @@index([memberId, movement])
}
