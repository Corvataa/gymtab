# Copiá este archivo como .env y completá los valores.

# Supabase > Project Settings > Database > Connection string
# DATABASE_URL: "Transaction pooler" (puerto 6543), agregando ?pgbouncer=true al final
DATABASE_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: "Session pooler" (puerto 5432)
DIRECT_URL="postgresql://postgres.xxxx:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Contraseña del panel /admin
ADMIN_PASSWORD="elegí-una-contraseña-segura"

# Clave para firmar las sesiones. Generala con: openssl rand -base64 32
SESSION_SECRET="una-clave-larga-y-aleatoria"
